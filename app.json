{
  "expo": {
    "name": "EventCampus",
    "slug": "eventcampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#378ADD",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eventcampus.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para confirmar presença no evento."
      }
    },
    "android": {
      "package": "com.eventcampus.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso à câmera para escanear QR Code."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir acesso à localização para confirmar presença no evento."
        }
      ],
      "expo-font"
    ],
    "scheme": "eventcampus",
    "extra": {
      "eas": {
        "projectId": "9dbf9522-24da-420e-868b-b1a465b66392"
      }
    },
    "owner": "nathalialimax"
  }
}
